{
  "name": "habit-tracker",
  "version": "1.0.0",
  "description": "Life Analytics & Efficiency Engine - 24-hour time tracking and academic performance analytics",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/server.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build"
  },
  "keywords": [
    "habit-tracking",
    "time-management",
    "productivity",
    "academic-analytics"
  ],
  "author": "alamin02",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.0.0",
    "dotenv": "^16.0.3",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "express-validator": "^7.0.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "concurrently": "^7.0.0"
  }
}
